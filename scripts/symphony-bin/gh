#!/bin/sh
set -eu

wrapper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
remaining_path=${PATH:-}
real_path=
while [ -n "$remaining_path" ]; do
  case "$remaining_path" in
    *:*) path_entry=${remaining_path%%:*}; remaining_path=${remaining_path#*:} ;;
    *) path_entry=$remaining_path; remaining_path= ;;
  esac
  if [ "$path_entry" != "$wrapper_dir" ]; then
    real_path=${real_path:+"$real_path:"}$path_entry
  fi
done
real_gh=$(PATH="$real_path" command -v gh) || {
  echo "Real GitHub CLI command not found outside Symphony wrapper." >&2
  exit 127
}
unset GH_TOKEN GITHUB_TOKEN SYMPHONY_GITHUB_TOKEN SYMPHONY_AGENT_GITHUB_TOKEN
PATH=$real_path
export PATH
exec "$real_gh" "$@"
