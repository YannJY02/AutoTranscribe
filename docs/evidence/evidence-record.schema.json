{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YannJY02/AutoTranscribe/blob/main/docs/evidence/evidence-record.schema.json",
  "title": "InsightKit normalized evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "linear_issue_id", "github_issue_or_pr_id", "lifecycle_stage", "lifecycle_transition", "source_type", "source_id", "source_ref", "revision", "artifact_sha256", "observed_at", "environment", "result", "claim_class", "promotion_category", "privacy_class", "fact", "gap_or_decision", "owner_action", "recheck_source", "human_gate", "unknowns", "supersedes"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^ev_v1_[0-9a-f]{24}$"},
    "linear_issue_id": {"oneOf": [{"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"}, {"type": "null"}]},
    "github_issue_or_pr_id": {"oneOf": [{"type": "string", "pattern": "^(GH-|PR-|#)?[0-9]+$"}, {"type": "null"}]},
    "lifecycle_stage": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "lifecycle_transition": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "source_type": {"enum": ["linear", "github", "ci", "repository", "analytics", "diagnostics", "pilot"]},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact_sha256": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
    "observed_at": {"type": "string", "format": "date-time"},
    "environment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "result": {"enum": ["passed", "failed", "blocked", "unobserved", "superseded"]},
    "claim_class": {"enum": ["observed", "accepted-decision", "inference", "unknown"]},
    "promotion_category": {"oneOf": [{"enum": ["scope", "acceptance", "dependency", "priority", "status", "gate", "milestone", "owner-action", "continue-or-stop"]}, {"type": "null"}]},
    "privacy_class": {"enum": ["public-metadata", "repository-metadata", "approved-aggregate"]},
    "fact": {"type": "string", "minLength": 1, "maxLength": 500},
    "gap_or_decision": {"type": "string", "minLength": 1, "maxLength": 500},
    "owner_action": {"type": "string", "minLength": 1, "maxLength": 500},
    "recheck_source": {"type": "string", "minLength": 1, "maxLength": 500},
    "human_gate": {"type": "string", "minLength": 1, "maxLength": 500},
    "unknowns": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}},
    "supersedes": {"oneOf": [{"type": "string", "pattern": "^ev_v1_[0-9a-f]{24}$"}, {"type": "null"}]}
  }
}
