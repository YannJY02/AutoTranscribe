-- query_version: 1; event_schema_version: 1; dialect: PostHog HogQL
WITH event_source AS (
  SELECT event AS event_name, toTimeZone(timestamp, 'UTC') AS timestamp_utc,
    toInt(properties.event_sequence) AS event_sequence, toInt(properties.schema_version) AS schema_version,
    properties.environment AS environment, properties.app_session_id AS app_session_id,
    properties.workflow AS workflow
  FROM events
  WHERE properties.environment = {variables.environment}
    AND timestamp >= toDateTime({variables.window_start})
    AND timestamp < toDateTime({variables.window_end})
), eligible AS (
  SELECT * FROM event_source WHERE schema_version=1
), ordered AS (
  SELECT e.*,
    sum(if(event_name='workflow_started',1,0)) OVER (
      PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) attempt_index,
    sum(if(event_name='workflow_started',1,0)) OVER (
      PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
    ) prior_starts,
    sum(if(event_name IN ('workflow_completed','workflow_failed'),1,0)) OVER (
      PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
    ) prior_terminals
  FROM eligible e
), sessions AS (
  SELECT app_session_id,workflow,attempt_index,
    minOrNullIf(timestamp_utc,event_name='workflow_started') started,
    minOrNullIf(timestamp_utc,event_name='record_saved') saved,
    minOrNullIf(timestamp_utc,event_name='smart_minutes_review_opened') reviewed,
    minOrNullIf(timestamp_utc,event_name='export_completed') exported
  FROM ordered WHERE attempt_index>0 GROUP BY app_session_id,workflow,attempt_index
), quality AS (
  SELECT countIf(event_name='workflow_started' AND prior_starts>prior_terminals) overlapping_starts
  FROM ordered
)
SELECT countIf(started IS NOT NULL) started,
  countIf(saved>=started) record_saved,
  countIf(reviewed>=saved AND saved>=started) review_opened,
  countIf(exported>=reviewed AND reviewed>=saved AND saved>=started) export_completed,
  multiIf(overlapping_starts>0,'incomplete',started=0,'insufficient-data','requires-reconciliation') evidence_state
FROM sessions CROSS JOIN quality;
