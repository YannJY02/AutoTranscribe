-- query_version: 1; event_schema_version: 1; dialect: PostHog HogQL
WITH event_source AS (
  SELECT event AS event_name, toTimeZone(timestamp, 'UTC') AS timestamp_utc,
    toInt(properties.event_sequence) AS event_sequence, toInt(properties.schema_version) AS schema_version,
    properties.environment AS environment, properties.workflow AS workflow,
    properties.analysis_mode AS analysis_mode
  FROM events
  WHERE properties.environment = {variables.environment}
    AND timestamp >= toDateTime({variables.window_start})
    AND timestamp < toDateTime({variables.window_end})
)
SELECT 1 AS schema_version,{variables.environment} AS environment,
  {variables.window_start} AS window_start,{variables.window_end} AS window_end,
  event_name,workflow,analysis_mode,COUNT(*) AS remote_count,
  MIN(timestamp_utc) AS first_seen_utc,MAX(timestamp_utc) AS last_seen_utc
FROM event_source WHERE schema_version=1
GROUP BY event_name,workflow,analysis_mode ORDER BY event_name,workflow,analysis_mode;
