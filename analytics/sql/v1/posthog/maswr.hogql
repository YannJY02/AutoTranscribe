-- query_version: 1; event_schema_version: 1; dialect: PostHog HogQL
WITH raw_source AS (
  SELECT event AS event_name, toTimeZone(timestamp, 'UTC') AS timestamp_utc,
    toInt(properties.event_sequence) AS event_sequence, toInt(properties.schema_version) AS schema_version,
    properties.environment AS environment, properties.installation_id AS installation_id,
    properties.app_session_id AS app_session_id, properties.workflow AS workflow,
    properties.analysis_mode AS analysis_mode
  FROM events
  WHERE properties.environment = {variables.environment}
    AND timestamp < toDateTime({variables.window_end})
), anchored_source AS (
  SELECT *,max(if(schema_version=1 AND event_name IN ('workflow_started','record_reopened'),
    tuple(timestamp_utc,event_sequence,event_name),tuple(toDateTime(0),toInt(0),''))) OVER (
      PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) context_anchor
  FROM raw_source
), event_source AS (
  SELECT *,event_name='workflow_failed' AND tupleElement(context_anchor,3)='record_reopened' is_record_context_terminal
  FROM anchored_source
), window_source AS (
  SELECT * FROM event_source WHERE timestamp_utc >= toDateTime({variables.window_start})
), segments AS (
  SELECT 'live' workflow,'local' analysis_mode UNION ALL
  SELECT 'live','cloud' UNION ALL SELECT 'import','local' UNION ALL SELECT 'import','cloud'
), eligible AS (
  SELECT * FROM window_source WHERE schema_version=1
), pre_window_indexed AS (
  SELECT e.*,sum(if(event_name='workflow_started',1,0)) OVER (
    PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
  ) attempt_index
  FROM event_source e WHERE schema_version=1 AND timestamp_utc < toDateTime({variables.window_start})
), pre_window_attempts AS (
  SELECT app_session_id,workflow,attempt_index,countIf(event_name='workflow_started') starts,
    countIf(event_name='workflow_completed' OR event_name='workflow_failed' AND NOT is_record_context_terminal) terminal_events
  FROM pre_window_indexed WHERE attempt_index>0 GROUP BY app_session_id,workflow,attempt_index
), pre_window AS (
  SELECT app_session_id,workflow,countIf(starts>0 AND terminal_events=0) open_attempts
  FROM pre_window_attempts
  GROUP BY app_session_id,workflow
), indexed AS (
  SELECT e.*,
    sum(if(event_name='workflow_started',1,0)) OVER (
      PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) attempt_index,
    sum(if(event_name='workflow_completed' OR event_name='workflow_failed' AND NOT is_record_context_terminal,1,0)) OVER (
      PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) terminal_index
  FROM eligible e
), classified AS (
  SELECT i.*,coalesce(p.open_attempts,0) pre_window_open_attempts,
    NOT is_record_context_terminal AND event_name IN ('workflow_completed','workflow_failed')
      AND terminal_index<=coalesce(p.open_attempts,0) is_boundary_terminal
  FROM indexed i LEFT JOIN pre_window p USING(app_session_id,workflow)
), ordered AS (
  SELECT c.*,
    sum(if(event_name='workflow_started',1,0)) OVER (
      PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
    ) prior_starts,
    sum(if(event_name IN ('workflow_completed','workflow_failed') AND NOT is_record_context_terminal AND NOT is_boundary_terminal,1,0)) OVER (
      PARTITION BY app_session_id,workflow ORDER BY timestamp_utc,event_sequence
      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
    ) prior_terminals
  FROM classified c
), ranked AS (
  SELECT o.*,ROW_NUMBER() OVER (
    PARTITION BY app_session_id,workflow,attempt_index ORDER BY
      multiIf(event_name='workflow_completed',0,event_name='workflow_failed',1,event_name='workflow_started',2,3),
      event_sequence DESC
  ) path_rank FROM ordered o WHERE attempt_index>0 AND NOT is_record_context_terminal AND NOT is_boundary_terminal
), attempts AS (
  SELECT app_session_id,workflow,attempt_index,
    maxIf(analysis_mode,path_rank=1) analysis_mode,
    countIf(event_name='workflow_started') starts,countIf(event_name='workflow_completed') completions
  FROM ranked GROUP BY app_session_id,workflow,attempt_index
), boundary_quality AS (
  SELECT
    countIf(event_name IN ('workflow_completed','workflow_failed') AND NOT is_record_context_terminal AND attempt_index=0 AND NOT is_boundary_terminal) orphan_boundary_terminals,
    countIf(event_name='workflow_started' AND terminal_index<pre_window_open_attempts) ambiguous_boundary_starts
  FROM classified
), counts AS (
  SELECT workflow,analysis_mode,SUM(starts) starts,SUM(completions) completions
  FROM attempts GROUP BY workflow,analysis_mode
), event_quality AS (
  SELECT countIf(schema_version<>1) + countIf(event_sequence IS NULL OR event_sequence<=0) AS event_issues
  FROM window_source
), attempt_quality AS (
  SELECT countIf(starts<>1 OR completions>1) AS grouped_issues FROM attempts
), order_quality AS (
  SELECT countIf(event_name='workflow_started' AND prior_starts>prior_terminals) AS ordering_issues
  FROM ordered
), quality AS (
  SELECT event_issues+grouped_issues+ordering_issues+orphan_boundary_terminals+ambiguous_boundary_starts AS issues
  FROM event_quality CROSS JOIN attempt_quality CROSS JOIN order_quality CROSS JOIN boundary_quality
)
SELECT s.workflow,s.analysis_mode,coalesce(c.starts,0) AS eligible_attempts,
  coalesce(c.completions,0) AS successful_attempts,
  if(coalesce(c.starts,0)=0,NULL,c.completions/c.starts) AS maswr,
  multiIf(quality.issues>0,'incomplete',coalesce(c.starts,0)=0,'missing-segment','requires-reconciliation') AS evidence_state
FROM segments s LEFT JOIN counts c USING(workflow,analysis_mode) CROSS JOIN quality
ORDER BY s.workflow,s.analysis_mode;
