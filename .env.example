# Langfuse tracing is opt-in. Never commit real keys.
INSIGHTKIT_LANGFUSE_ENABLED=1
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Meeting transcripts and generated minutes are omitted by default.
# Enable only when the Langfuse project's privacy policy permits this content.
INSIGHTKIT_LANGFUSE_CAPTURE_CONTENT=0
