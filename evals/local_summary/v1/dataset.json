{
  "dataset_version": "local-summary-v1",
  "description": "Eight frozen synthetic-only requests for a bounded local summary screen; no real meeting text, previous summaries, or future outputs are input.",
  "max_generation_requests": 8,
  "source_policy": "Expectations and stories authored before any YAN-77 model generation.",
  "unknown_literals": [
    "",
    "unknown",
    "not specified",
    "unassigned",
    "unspecified",
    "TBD",
    "未明确",
    "未知",
    "未指定",
    "待确认",
    "待定",
    "待分配",
    "未分配"
  ],
  "common_checkpoints": [
    {
      "id": "highlights",
      "paths": [
        "highlight_insights[].quote",
        "highlight_insights[].reason",
        "highlight_insights[].speaker"
      ],
      "expectation": "Each quotation must faithfully correspond to the cited visible text, reason must not add facts, and speaker must be correctly attributed. Translation/paraphrase needs explicit review; substring presence is not a verdict.",
      "source_segment_ids": [],
      "required": true
    },
    {
      "id": "perspectives",
      "paths": [
        "speaker_perspectives[].speaker",
        "speaker_perspectives[].viewpoints[]"
      ],
      "expectation": "Assign only statements actually expressed by that participant. An assignee named by another participant has not thereby spoken. Preserve uncertainty, negation, and later corrections.",
      "source_segment_ids": [],
      "required": true
    },
    {
      "id": "timeline",
      "paths": [
        "timeline_beats[].timestamp",
        "timeline_beats[].title",
        "timeline_beats[].summary"
      ],
      "expectation": "Timeline descriptions follow the visible segment chronology; proposals, decisions, and corrections must stay distinguishable. Timestamp range checks alone do not prove support.",
      "source_segment_ids": [],
      "required": true
    },
    {
      "id": "links",
      "paths": [
        "provenance_links[].label",
        "provenance_links[].url"
      ],
      "expectation": "No external document, meeting, or URL is supplied. Empty links are allowed. Any nonempty link needs an explicit runner-provided source/provenance explanation; never invent a source.",
      "source_segment_ids": [],
      "required": true
    },
    {
      "id": "all-claims",
      "paths": [
        "session_overview",
        "highlight_insights[]",
        "speaker_perspectives[]",
        "decision_ledger[]",
        "action_tracks[]",
        "timeline_beats[]",
        "provenance_links[]"
      ],
      "expectation": "Review EVERY generated claim, not only expected facts. Flag unsupported priority/urgency/completion, rationale, person, date, option, external source, approval, and causal claims. The schema-required priority/status may be a neutral default, but it must not be represented as an explicit meeting commitment.",
      "source_segment_ids": [],
      "required": true
    }
  ],
  "stories": {
    "bilingual-plan-correction": {
      "source": "Authored synthetic bilingual story for YAN-77; no real recording, person, or meeting.",
      "safety": {
        "synthetic": true
      },
      "segments": [
        {
          "id": "bilingual-plan-correction:s01",
          "start_ms": 0,
          "end_ms": 13000,
          "speaker": "Lin",
          "text": "这是虚构的 Harbor rehearsal。I propose uploading the demo to a cloud service next Friday；这只是提议，还没有获批。",
          "stable": true
        },
        {
          "id": "bilingual-plan-correction:s02",
          "start_ms": 14000,
          "end_ms": 28000,
          "speaker": "Mei",
          "text": "预算没有批准，也没有客户同意。我们还要整理风险清单，但负责人和截止日期都未定；现在没有分派这项工作。",
          "stable": true
        },
        {
          "id": "bilingual-plan-correction:s03",
          "start_ms": 30000,
          "end_ms": 46000,
          "speaker": "Lin",
          "text": "决定采用 offline-only demo，不上传任何测试文本，因为这些是假数据。Mei 负责完成 demo checklist，截止 Friday。",
          "stable": true
        },
        {
          "id": "bilingual-plan-correction:s04",
          "start_ms": 47000,
          "end_ms": 64000,
          "speaker": "Mei",
          "text": "我接下 demo checklist，但 review meeting 的日期还没确定。风险清单的负责人和截止日期仍然未知。",
          "stable": true
        },
        {
          "id": "bilingual-plan-correction:s05",
          "start_ms": 68000,
          "end_ms": 88000,
          "speaker": "Lin",
          "text": "Correction: checklist 不再由 Mei 负责，改由 Ren 负责。截止从 Friday 改到 Monday。不是 Friday；Mei 不再是这项任务的责任人。",
          "stable": true
        },
        {
          "id": "bilingual-plan-correction:s06",
          "start_ms": 89000,
          "end_ms": 110000,
          "speaker": "Ren",
          "text": "Confirmed, I own the demo checklist and will finish it by Monday. 我们没有批准云端上传，也没有决定正式上线；风险清单仍未分派，日期也未定。",
          "stable": true
        }
      ]
    }
  },
